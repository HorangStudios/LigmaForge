{
  "name": "horanghill",
  "version": "0.6.8",
  "description": "Desktop app for the sandbox platform.",
  "homepage": "https://github.com/HorangStudios/LigmaForge",
  "main": "main.js",
  "scripts": {
    "test": "echo \"No test specified\"",
    "start": "electron ."
  },
  "repository": "https://github.com/HorangStudios/LigmaForge",
  "author": "HorangStudios",
  "license": "MIT",
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@faker-js/faker": "^10.2.0",
    "electron-updater": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.horangstudios.horanghill",
    "productName": "HorangHill",
    "publish": {
      "provider": "github",
      "releaseType": "release",
      "owner": "HorangStudios",
      "repo": "LigmaForge",
      "vPrefixedTagName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": false,
      "icon": "resources/css/HorangHill.png"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage",
        "rpm"
      ],
      "maintainer": "HorangStudios",
      "category": "Game",
      "icon": "resources/css/HorangHill.png"
    }
  }
}
